DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/door/state' -m 'open'
DRYRUN> logger -t awk-red -p daemon.info 'door is now open'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -t 'alarm/temp/kitchen' -m 'hot: 31.2C in kitchen'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/kitchen/temp_alarm' -m '1'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -t 'alarm/sensor' -m 'json sensor reports 33.7C'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/sensor/json/last' -m '33.7C'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/door/state' -m 'closed'
DRYRUN> logger -t awk-red -p daemon.info 'door is now closed'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -t 'alarm/temp/kitchen' -m 'back to normal: 27.5C in kitchen'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/kitchen/temp_alarm' -m '0'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -t 'alarm/temp/garden' -m 'hot: 33.9C in garden'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/garden/temp_alarm' -m '1'
DRYRUN> mosquitto_pub -h 'localhost' -p '1883' -r -t 'home/door/state' -m 'open'
DRYRUN> logger -t awk-red -p daemon.info 'door is now open'
