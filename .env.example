# awk-red configuration. Copy to .env and edit:
#
#     cp .env.example .env
#
# .env is *sourced* by the shell at start-up, so it may contain normal shell
# syntax. It is never committed - .gitignore already excludes it.
#
# Precedence: command line > environment > .env > built-in default.
#
# Inputs are opt-in and independent: --mqtt, --webhook, --tick, --pipe and -i
# each have to be asked for (or set their AWKRED_* variable below). Merely
# naming a broker with MQTT_HOST or -h never starts a subscription.

# --- inputs -----------------------------------------------------------------
# 1 subscribes to the broker, 0 does not. --mqtt on the command line wins, so
# you can flip this off everywhere and still ask for it per run. The broker
# settings below are used either way, by pub() in rules and by the input when
# it is on.
AWKRED_MQTT=0

# --- broker (for --mqtt and for pub() in every mode) -------------------------
MQTT_HOST=localhost
MQTT_PORT=1883

# Credentials are optional; leave both empty for an anonymous broker. They are
# handed to mosquitto_sub and mosquitto_pub as -u/-P, which means the password
# is visible in ps to other users on this machine. On a shared host, connect
# over TLS or give the broker its own per-service user.
MQTT_USER=mosquitto
MQTT_PASS=change-me

# TLS: set MQTT_TLS=1 and/or point MQTT_CAFILE at a CA bundle.
MQTT_TLS=0
MQTT_CAFILE=

# Client id shown in the broker log and in broker-side tooling.
MQTT_CLIENT_ID=awk-red

# --- subscription -----------------------------------------------------------
# MQTT_TOPIC is the subscription filter handed to mosquitto_sub -t when the
# MQTT input is on.
MQTT_TOPIC=#

# --- behaviour --------------------------------------------------------------
# DRYRUN=1 prints every command instead of running it. The command line
# equivalent is --dry-run / -n, which wins over this value.
DRYRUN=0

# Run only the first matching rule instead of all of them.
AWKRED_FIRST_MATCH=0

# Log every routing decision to stderr.
AWKRED_VERBOSE=0

# Maximum depth of a chain() created by a rule. A chained event that keeps
# matching itself is dropped once it has been chained this many times, so a
# feedback loop is cut off instead of spinning. See "Chaining rules" in
# README.md.
AWKRED_CHAIN_MAX=32

# --- rules and scheduling ---------------------------------------------------
# Directory whose *.awk files are loaded, in sorted order.
AWKRED_RULES=examples

# Clock interval in whole seconds, 0 = off. awk-red publishes a message on
# awk-red/tick/<ISO-8601 timestamp> with the epoch seconds as payload, so rules
# can run on a schedule even when the broker is silent. Not usable together with
# --input: a recording has a fixed timeline, so put the tick line in the file.
AWKRED_TICK=0

# --- HTTP webhooks ----------------------------------------------------------
# Enable HTTP webhooks. Set AWKRED_WEBHOOK=1 or pass --webhook on the command
# line to listen for requests. The port defaults to 3737 and can be changed
# with -P PORT or AWKRED_HTTP_PORT. The listener binds all interfaces, so only
# turn it on if you firewall the port.
#
# One request at a time, one request per connection:
#     POST /door/front?p=open   ->   post/door/front open
# See "HTTP webhooks" in README.md for the whole contract.
AWKRED_WEBHOOK=0
AWKRED_HTTP_PORT=3737

# --- pipe (any command's stdout) --------------------------------------------
# Run a command and treat its stdout as a subscription: one "topic payload" line
# per message. Empty = off. This is how a poller (mbpoll, curl, sensors) feeds
# the engine; see "Piping in a command" in README.md and the examples/modbus.sh
# recipe for Modbus/TCP.
AWKRED_PIPE=

# 0 = the command is long-lived (its exit ends the run, like mosquitto_sub).
# Set it to whole seconds to poll: the command is rerun on that schedule, and a
# failed run is retried instead of taking the router down.
AWKRED_PIPE_EVERY=0

# 1 = drop a topic's repeated payloads, so a poll only becomes an event when
# something changes. State is per run and per source (pipe only). 0 = off.
AWKRED_PIPE_CHANGED=0